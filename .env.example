# --- Database ---------------------------------------------------------------
# Inside docker compose the app always talks to the `db` service (compose overrides this).
# For `pnpm dev` on the host, point it at the published port, e.g. postgres://app:app@localhost:5432/app
DATABASE_URL=postgres://app:app@db:5432/app
# Host port for the compose `db` service (bound to 127.0.0.1; change if 5432 is taken locally)
DB_PORT=5432
POSTGRES_PASSWORD=app          # change on a server

# --- LLM (switch provider with zero code changes) ----------------------------
LLM_PROVIDER=openai            # openai | google | openrouter
LLM_MODEL=gpt-4.1-mini         # any tool-calling capable model id for the provider
LLM_FAST_MODEL=                # optional: cheaper model for routing / seller persona / checklist
LLM_VISION_MODEL=              # optional: photo search (F1); default openai → LLM_MODEL, google → gemini-3.1-flash-lite, openrouter → openai/gpt-4.1-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=               # optional (proxies / OpenAI-compatible gateways)
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=

# --- Data ---------------------------------------------------------------------
DATA_DIR=./data                # where shops.csv / products.csv / offers.csv live (/data in docker)
DATASET_AS_OF=2026-10-13       # "now" for price-age computations
AUTO_SEED=true                 # docker: seed automatically on first boot when products is empty

# --- Seller simulator ------------------------------------------------------------
SIM_SALT=hamrah-40            # deterministic seed for simulated seller follow-ups (tuned for the demo, see docs/DECISIONS.md)

# --- Deploy -------------------------------------------------------------------
APP_URL=https://example.com
APP_DOMAIN=example.com         # Caddy site address; use :80 for plain HTTP (local test)
HTTP_PORT=80
HTTPS_PORT=443
NPM_REGISTRY=https://registry.npmjs.org/   # build-time npm mirror (useful on Iranian servers)
