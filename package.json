{
  "name": "torob-seller-agent",
  "version": "1.0.0",
  "private": true,
  "description": "همراه خرید — AI in-person shopping assistant for Tehran (Torob dataset)",
  "license": "MIT",
  "packageManager": "pnpm@10.6.5",
  "scripts": {
    "dev": "next dev --turbopack -p ${PORT:-3010}",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "migrate": "tsx lib/db/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "golden": "tsx scripts/golden.ts && tsx scripts/missions.ts && tsx scripts/features.ts",
    "features": "tsx scripts/features.ts",
    "missions": "tsx scripts/missions.ts",
    "llm-check": "tsx scripts/llm-check.ts",
    "smoke": "tsx scripts/smoke.ts",
    "build:scripts": "esbuild lib/db/migrate.ts scripts/seed.ts --bundle --platform=node --target=node22 --format=cjs --outdir=dist-scripts --entry-names=[name] --out-extension:.js=.cjs --external:pg-native",
    "scenario": "tsx scripts/scenario.ts",
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "vision-check": "tsx scripts/vision-check.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.102",
    "@ai-sdk/openai": "^4.0.99",
    "@ai-sdk/provider": "4.0.31",
    "@ai-sdk/react": "^4.0.152",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "ai": "^7.0.148",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "csv-parse": "^6",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.61.0",
    "maplibre-gl": "^6.15.0",
    "next": "15.5.28",
    "next-themes": "^0.4.6",
    "pg": "^8",
    "pg-copy-streams": "^7",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@types/pg-copy-streams": "^1.2.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.8",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5.9",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver",
      "sharp"
    ]
  }
}
